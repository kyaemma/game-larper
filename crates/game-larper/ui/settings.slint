// Settings content for the side panel. Values stay staged until Save.

import { AboutSlint, Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, LogoMark, Button, Toggle, SectionLabel, FocusRing } from "controls.slint";

component Section inherits HorizontalLayout {
    in property <string> text;
    padding-left: 10px;
    padding-top: 14px;
    padding-bottom: 4px;
    SectionLabel { text: root.text; }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in-out property <bool> checked;
    callback toggled(bool);

    min-height: root.hint == "" ? 38px : 48px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    touch := TouchArea {
        clicked => { toggle.flip(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.text-m;
                wrap: word-wrap;
            }
            if root.hint != "": Text {
                text: root.hint;
                color: Theme.text-3;
                font-size: Theme.text-s;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            toggle := Toggle {
                label: root.label;
                checked <=> root.checked;
                toggled(value) => { root.toggled(value); }
            }
        }
    }
}

component DataRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;
    in property <string> action;
    in property <image> icon;
    callback clicked();

    padding-left: 10px;
    padding-right: 10px;
    spacing: 12px;
    min-height: root.detail == "" ? 38px : 48px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.text-m;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-3;
            font-size: Theme.text-s;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;
        Button {
            text: root.action;
            icon: root.icon;
            height: 28px;
            font-size: Theme.text-s;
            clicked => { root.clicked(); }
        }
    }
}

// A row that opens something outside the app: icon tile, label, detail, and an external mark.
component LinkRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> detail;
    callback clicked();

    min-height: 48px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.detail;
    accessible-action-default => { root.clicked(); }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.radius-m;
                background: Theme.fill;
                Icon {
                    source: root.icon;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: touch.has-hover || focus.has-focus ? Theme.text : Theme.text-2;
                    animate colorize { duration: Theme.quick; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.text-m;
            }
            Text {
                text: root.detail;
                color: Theme.text-3;
                font-size: Theme.text-s;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.external;
                width: 14px;
                height: 14px;
                tint: touch.has-hover || focus.has-focus ? Theme.text-2 : Theme.text-3;
                animate colorize { duration: Theme.quick; }
            }
        }
    }
    FocusRing {
        active: focus.has-focus;
        width: root.width + 6px;
        height: root.height + 6px;
    }
}

export component SettingsView inherits VerticalLayout {
    in-out property <bool> launch-with-windows;
    in property <string> startup-label: "Launch with Windows";
    in-out property <bool> start-minimized;
    in-out property <bool> close-to-tray;
    in-out property <bool> restore-last;
    in-out property <bool> auto-resume;
    in-out property <bool> preserve-queue;
    in property <string> database-detail;
    in property <string> version;
    callback changed();
    callback refresh-catalog();
    callback clear-images();
    callback open-logs();
    callback open-data();
    callback notify(string);

    // Fixed project metadata, never user input.
    property <string> contributors-url: "https://github.com/kyaemma/game-larper/graphs/contributors";

    function open-contributors() {
        if (!Platform.open-url(root.contributors-url)) {
            root.notify("Couldn't open the browser.");
        }
    }

    // The panel is always dark, so the Slint badge must not follow a light OS theme.
    init => { Palette.color-scheme = ColorScheme.dark; }

    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 12px;
    spacing: 0px;

    Section { text: "GENERAL"; }
    SettingRow {
        label: root.startup-label;
        checked <=> root.launch-with-windows;
        toggled => { root.changed(); }
    }
    SettingRow {
        label: "Start minimized";
        hint: "Open straight to the tray.";
        checked <=> root.start-minimized;
        toggled => { root.changed(); }
    }
    SettingRow {
        label: "Close button minimizes to tray";
        checked <=> root.close-to-tray;
        toggled => { root.changed(); }
    }

    Section { text: "SESSION"; }
    SettingRow {
        label: "Restore last selected game";
        checked <=> root.restore-last;
        toggled => { root.changed(); }
    }
    SettingRow {
        label: "Auto-resume the manual session";
        hint: "Play the restored game again at launch.";
        checked <=> root.auto-resume;
        toggled => { root.changed(); }
    }
    SettingRow {
        label: "Preserve the queue across restarts";
        checked <=> root.preserve-queue;
        toggled => { root.changed(); }
    }

    Section { text: "DATA"; }
    DataRow {
        label: "Game database";
        detail: root.database-detail;
        action: "Refresh";
        clicked => { root.refresh-catalog(); }
    }
    DataRow {
        label: "Artwork cache";
        action: "Clear";
        clicked => { root.clear-images(); }
    }
    DataRow {
        label: "Logs";
        detail: "Live console and log files.";
        action: "View";
        clicked => { root.open-logs(); }
    }
    DataRow {
        label: "Data folder";
        action: "Open";
        clicked => { root.open-data(); }
    }

    Section { text: "ABOUT"; }
    HorizontalLayout {
        min-height: 48px;
        padding-left: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            LogoMark {
                width: 32px;
                height: 32px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: "Game Larper " + root.version;
                color: Theme.text;
                font-size: Theme.text-m;
                font-weight: 600;
            }
            Text {
                text: "Pick a game. Press play. Discord gets lied to.";
                color: Theme.text-3;
                font-size: Theme.text-s;
                wrap: word-wrap;
            }
        }
    }
    LinkRow {
        icon: Icons.users;
        label: "Contributors";
        detail: "View project contributors";
        clicked => { root.open-contributors(); }
    }

    // Required attribution for Slint's royalty-free desktop license.
    HorizontalLayout {
        alignment: center;
        padding-top: 10px;
        AboutSlint { preferred-width: 184px; }
    }
}
