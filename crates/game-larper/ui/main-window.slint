// The main window: one calm vertical column.
// Title bar, search, results, the current session, then a quiet utility row.

import { Theme, Icons } from "theme.slint";
import { Icon, LogoMark, CaptionButton, Hairline, Gutter } from "controls.slint";
import { Hit } from "models.slint";
import { SearchField, ResultsList, SkeletonRow, Message } from "search.slint";
import { SessionDock, UtilityBar, Toast } from "dock.slint";

component TitleBar inherits Rectangle {
    in property <bool> maximized;
    callback minimize();
    callback toggle-maximize();
    callback close();

    height: 40px;
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            LogoMark {
                width: 18px;
                height: 18px;
            }
        }
        Text {
            text: "Game Larper";
            color: Theme.text-2;
            font-size: Theme.text-m;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        CaptionButton {
            icon: Icons.window-minimize;
            label: "Minimize";
            clicked => { root.minimize(); }
        }
        CaptionButton {
            icon: root.maximized ? Icons.window-restore : Icons.window-maximize;
            label: root.maximized ? "Restore" : "Maximize";
            clicked => { root.toggle-maximize(); }
        }
        CaptionButton {
            icon: Icons.window-close;
            label: "Close";
            danger: true;
            clicked => { root.close(); }
        }
    }
}

component LoadingView inherits Rectangle {
    in property <string> label;
    background: Theme.bg;
    TouchArea { }
    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding-bottom: 48px;
        HorizontalLayout {
            alignment: center;
            LogoMark {
                width: 56px;
                height: 56px;
            }
        }
        Text {
            text: root.label;
            color: Theme.text-2;
            font-size: Theme.text-m;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 112px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.fill;
                clip: true;
                Rectangle {
                    property <float> t: mod(animation-tick() / 1ms, 1200) / 1200;
                    property <float> eased: self.t * self.t * (3 - 2 * self.t);
                    width: 36px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.accent;
                    x: self.eased * (parent.width + self.width) - self.width;
                }
            }
        }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> highlighted;
    callback activated();
    height: 32px;
    border-radius: Theme.radius-s;
    background: root.enabled && (touch.has-hover || root.highlighted) ? Theme.fill-hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: 14px;
                height: 14px;
                tint: root.enabled ? Theme.text-2 : Theme.text-3;
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-3;
            font-size: Theme.text-m;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "Game Larper";
    icon: @image-url("../../../assets/branding/game-larper-logo.png");
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 6px;
    min-width: 440px;
    min-height: 560px;
    preferred-width: 560px;
    preferred-height: 740px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.text-m;

    // Startup.
    in-out property <bool> loading: true;
    in-out property <string> loading-label: "Loading games…";

    // Search and results.
    in-out property <string> query;
    in-out property <[Hit]> hits;
    // "idle" | "pending" | "ready" | "empty" | "unavailable"
    in-out property <string> results-state: "idle";
    in-out property <int> selected-index: -1;
    in-out property <string> db-status;
    in-out property <color> db-color: Theme.text-3;

    // Current session.
    in-out property <bool> session-visible;
    in-out property <image> session-art;
    in-out property <string> session-name;
    in-out property <string> session-state: "Ready";
    in-out property <string> session-mode: "stopped";
    in-out property <color> session-color: Theme.text-3;
    in-out property <string> session-time: "00:00:00";
    in-out property <string> session-note;
    in-out property <string> play-label: "Play";
    in-out property <bool> play-enabled;
    in-out property <bool> pause-enabled;
    in-out property <bool> stop-enabled;
    in-out property <bool> resume-queue;
    in-out property <bool> play-blocked;

    // Utility row.
    in-out property <int> queue-count;
    in-out property <string> queue-line;
    // "" | "queue" | "settings"
    in-out property <string> panel;

    in-out property <string> toast;
    in-out property <bool> toast-visible;
    in-out property <string> toast-kind: "info";

    callback query-edited(string);
    callback step(int);
    callback choose(int);
    callback activate(int);
    callback play();
    callback pause();
    callback stop();
    callback queue-resume();
    callback toggle-queue();
    callback open-settings();
    callback add-to-queue(int);
    callback copy-text(string, string);
    callback notify(string);
    callback refresh-catalog();
    callback request-close();

    // Row menu target.
    property <int> menu-index: -1;
    property <string> menu-steam;
    property <string> menu-id;
    property <length> menu-x;
    property <length> menu-y;
    property <int> menu-focus: -1;

    function open-menu(index: int, x: length, y: length) {
        if (index < 0 || index >= root.hits.length) {
            return;
        }
        root.menu-index = index;
        root.menu-steam = root.hits[index].steam-id;
        root.menu-id = root.hits[index].id;
        root.menu-x = x;
        root.menu-y = y;
        root.menu-focus = -1;
        menu.show();
    }

    function open-steam(steam-id: string) {
        if (steam-id != "" && !Platform.open-url("https://store.steampowered.com/app/" + steam-id + "/")) {
            root.notify("Couldn't open the browser.");
        }
    }

    changed selected-index => {
        list.reveal(root.selected-index);
    }

    forward-focus: search;

    VerticalLayout {
        TitleBar {
            maximized: root.maximized;
            minimize => { root.minimized = true; }
            toggle-maximize => { root.maximized = !root.maximized; }
            close => { root.request-close(); }
        }
        HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 12px;
            Gutter { }
            search := SearchField {
                horizontal-stretch: 100;
                max-width: 680px;
                text <=> root.query;
                edited(text) => {
                    root.query-edited(text);
                    list.top();
                }
                accepted => {
                    if (root.hits.length > 0) {
                        root.activate(root.selected-index >= 0 ? root.selected-index : 0);
                    }
                }
                step(delta) => { root.step(delta); }
                menu => {
                    if (root.selected-index >= 0) {
                        root.open-menu(root.selected-index, search.absolute-position.x + search.width - 220px, search.absolute-position.y + search.height + 6px);
                    }
                }
            }
            Gutter { }
        }
        results := HorizontalLayout {
            vertical-stretch: 1;
            Gutter { min-width: 12px; }
            Rectangle {
                horizontal-stretch: 100;
                max-width: 696px;
                list := ResultsList {
                    hits: root.hits;
                    // The dock follows the selection, so the selected row is the one playing.
                    playing-id: root.session-mode == "playing" && root.selected-index >= 0 ? root.hits[root.selected-index].id : "";
                    blocked: root.play-blocked;
                    opacity: root.results-state == "ready" ? 1 : 0;
                    visible: self.opacity > 0;
                    animate opacity { duration: Theme.normal; easing: ease-out; }
                    select(index) => { root.choose(index); }
                    play(index) => { root.activate(index); }
                    menu(index, x, y) => { root.open-menu(index, x, y); }
                    steam(id) => { root.open-steam(id); }
                }
                if root.results-state == "pending": VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    SkeletonRow { name-width: 190px; }
                    SkeletonRow { name-width: 140px; }
                    SkeletonRow { name-width: 170px; }
                    SkeletonRow { name-width: 120px; }
                }
                if root.results-state == "idle": Message {
                    logo: true;
                    title: "Pick a game.";
                    body: "Type a name. Elden is a fine place to start.";
                }
                if root.results-state == "empty": Message {
                    title: "Nothing called “" + root.query + "”";
                    body: "Only games Discord knows how to detect show up here.";
                }
                if root.results-state == "unavailable": Message {
                    title: "The game list isn’t here yet";
                    body: "Game Larper couldn’t load Discord’s list of detectable games.";
                    action: "Try again";
                    action-clicked => { root.refresh-catalog(); }
                }
            }
            Gutter { min-width: 12px; }
        }
        if root.session-visible: VerticalLayout {
            vertical-stretch: 0;
            Hairline { }
            SessionDock {
                art: root.session-art;
                name: root.session-name;
                state-label: root.session-state;
                state-color: root.session-color;
                mode: root.session-mode;
                time: root.session-time;
                note: root.session-note;
                play-label: root.play-label;
                play-enabled: root.play-enabled || root.resume-queue;
                pause-enabled: root.pause-enabled;
                stop-enabled: root.stop-enabled;
                play => {
                    if (root.resume-queue) {
                        root.queue-resume();
                    } else {
                        root.play();
                    }
                }
                pause => { root.pause(); }
                stop => { root.stop(); }
            }
        }
        Hairline { }
        UtilityBar {
            queue-count: root.queue-count;
            queue-line: root.queue-line;
            queue-open: root.panel == "queue";
            settings-open: root.panel == "settings";
            db-status: root.db-status;
            db-color: root.db-color;
            queue => { root.toggle-queue(); }
            settings => { root.open-settings(); }
        }
    }

    Toast {
        text: root.toast;
        shown: root.toast-visible;
        kind: root.toast-kind;
        x: (root.width - self.width) / 2;
        y: results.y + results.height - self.height - 14px + (root.toast-visible ? 0px : 6px);
        animate y { duration: Theme.normal; easing: ease-out; }
    }

    LoadingView {
        y: 40px;
        height: root.height - 40px;
        label: root.loading-label;
        opacity: root.loading ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 180ms; easing: ease-out; }
    }

    menu := PopupWindow {
        x: max(8px, min(root.menu-x, root.width - self.width - 8px));
        y: min(root.menu-y, root.height - self.height - 8px);
        width: 216px;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000080;
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    menu.close();
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.menu-focus = mod(root.menu-focus + 1, root.menu-steam != "" ? 5 : 3);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.menu-focus = root.menu-focus <= 0 ? (root.menu-steam != "" ? 4 : 2) : root.menu-focus - 1;
                    return accept;
                }
                if (event.text == Key.Return || event.text == Key.Space) {
                    if (root.menu-focus == 0) {
                        root.activate(root.menu-index);
                    } else if (root.menu-focus == 1) {
                        root.add-to-queue(root.menu-index);
                    } else if (root.menu-steam != "" && root.menu-focus == 2) {
                        root.open-steam(root.menu-steam);
                    } else if (root.menu-steam != "" && root.menu-focus == 3) {
                        root.copy-text(root.menu-steam, "Steam AppID");
                    } else if (root.menu-focus >= 2) {
                        root.copy-text(root.menu-id, "Discord App ID");
                    }
                    menu.close();
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuItem {
                    text: "Play";
                    icon: Icons.play;
                    enabled: !root.play-blocked && !(root.session-mode == "playing" && root.menu-index == root.selected-index);
                    highlighted: root.menu-focus == 0;
                    activated => { root.activate(root.menu-index); }
                }
                MenuItem {
                    text: "Add to queue";
                    icon: Icons.plus;
                    highlighted: root.menu-focus == 1;
                    activated => { root.add-to-queue(root.menu-index); }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                }
                if root.menu-steam != "": MenuItem {
                    text: "Open on Steam";
                    icon: Icons.external;
                    highlighted: root.menu-focus == 2;
                    activated => { root.open-steam(root.menu-steam); }
                }
                if root.menu-steam != "": MenuItem {
                    text: "Copy Steam AppID";
                    icon: Icons.copy;
                    highlighted: root.menu-focus == 3;
                    activated => { root.copy-text(root.menu-steam, "Steam AppID"); }
                }
                MenuItem {
                    text: "Copy Discord App ID";
                    icon: Icons.copy;
                    highlighted: root.menu-focus == (root.menu-steam != "" ? 4 : 2);
                    activated => { root.copy-text(root.menu-id, "Discord App ID"); }
                }
            }
        }
    }
}
