// Detached live log console. It intentionally behaves like a normal utility window.
//
// Sizing flows one way only: the window gives the list its size, and each row derives its
// height from that width. Rows never set their own width and the list never reports its
// content size back to the window, so no layout constraint depends on its own result.

import { Theme, Icons } from "theme.slint";
import { Button, CaptionButton, Hairline } from "controls.slint";
import { LogRow } from "models.slint";

component LogTitleBar inherits Rectangle {
    callback close();

    height: 40px;
    background: Theme.bg-alt;
    WindowMoveArea {
        width: 100%;
        height: 100%;
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 9px;
        Text {
            text: "Logs";
            color: Theme.text;
            font-size: Theme.text-m;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        CaptionButton {
            icon: Icons.window-close;
            label: "Close";
            danger: true;
            clicked => { root.close(); }
        }
    }
}

component LogLine inherits Rectangle {
    in property <LogRow> entry;
    // Shared column width, measured once by the window from the widest level label.
    in property <length> level-width;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 10px;

        Text {
            text: root.entry.time;
            color: Theme.text-3;
            font-size: Theme.text-s;
            font-family: Theme.mono;
            vertical-alignment: top;
        }
        Text {
            text: root.entry.level;
            color: root.entry.tone;
            font-size: Theme.text-s;
            font-family: Theme.mono;
            font-weight: 700;
            min-width: root.level-width;
            vertical-alignment: top;
        }
        Text {
            text: root.entry.message;
            color: Theme.text-2;
            font-size: Theme.text-s;
            font-family: Theme.mono;
            wrap: word-wrap;
            // Long paths wrap anywhere instead of widening the window to their longest word.
            min-width: 0px;
            horizontal-stretch: 1;
            vertical-alignment: top;
        }
    }
}

export component LogWindow inherits Window {
    title: "Logs · Game Larper";
    icon: @image-url("../../../assets/branding/game-larper-logo.png");
    no-frame: true;
    resize-border-width: 6px;
    min-width: 520px;
    min-height: 320px;
    preferred-width: 760px;
    preferred-height: 460px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.text-m;

    in-out property <[LogRow]> rows;
    callback close-requested();
    callback copy();
    callback clear();
    callback open-folder();

    // Keep the newest line in view until the user scrolls away from the bottom.
    property <bool> follow: true;

    forward-focus: keys;

    // Measures the level column; never shown.
    level-probe := Text {
        text: "SUCCESS";
        font-size: Theme.text-s;
        font-family: Theme.mono;
        font-weight: 700;
        visible: false;
    }

    keys := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }

        VerticalLayout {
            LogTitleBar {
                close => { root.close-requested(); }
            }
            Hairline { }

            Rectangle {
                vertical-stretch: 1;

                // Explicit placement keeps the list's content size out of the window's
                // constraints; otherwise a short log would cap how tall the window can grow.
                flick := Flickable {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    content-width: self.width;
                    content-height: lines.preferred-height;
                    flicked => {
                        root.follow = self.content-y <= self.height - self.content-height + 2px;
                    }
                    changed content-height => {
                        if (root.follow) {
                            self.content-y = min(0px, self.height - self.content-height);
                        }
                    }
                    changed height => {
                        if (root.follow) {
                            self.content-y = min(0px, self.height - self.content-height);
                        }
                    }

                    lines := VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        for entry in root.rows: LogLine {
                            entry: entry;
                            level-width: level-probe.preferred-width;
                        }
                    }
                }

                if flick.content-height > flick.height: Rectangle {
                    property <length> track: flick.height;
                    property <float> ratio: flick.height / flick.content-height;
                    x: parent.width - self.width - 1px;
                    width: thumb-touch.has-hover || thumb-touch.pressed ? 6px : 4px;
                    height: max(28px, self.track * self.ratio);
                    y: (-flick.content-y) / (flick.content-height - flick.height) * (self.track - self.height);
                    border-radius: self.width / 2;
                    background: thumb-touch.pressed ? #FFFFFF40 : thumb-touch.has-hover ? #FFFFFF2E : #FFFFFF1C;
                    animate width, background { duration: Theme.quick; }
                    thumb-touch := TouchArea {
                        property <length> start;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                self.start = flick.content-y;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                flick.content-y = max(flick.height - flick.content-height, min(0px,
                                    self.start - (self.mouse-y - self.pressed-y) * flick.content-height / flick.height));
                                root.follow = flick.content-y <= flick.height - flick.content-height + 2px;
                            }
                        }
                    }
                }

                if root.rows.length == 0: Text {
                    text: "No live logs yet.";
                    color: Theme.text-3;
                    font-size: Theme.text-m;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Hairline { }
            HorizontalLayout {
                height: 52px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    text: root.rows.length + (root.rows.length == 1 ? " entry" : " entries");
                    color: Theme.text-3;
                    font-size: Theme.text-s;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Open folder";
                        kind: "ghost";
                        height: 30px;
                        clicked => { root.open-folder(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Clear";
                        kind: "ghost";
                        height: 30px;
                        enabled: root.rows.length > 0;
                        clicked => {
                            root.follow = true;
                            root.clear();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Copy";
                        kind: "primary";
                        height: 30px;
                        enabled: root.rows.length > 0;
                        clicked => { root.copy(); }
                    }
                }
            }
        }
    }
}
