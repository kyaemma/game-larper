// Entry point for slint-build. Rust drives the main window, attached side panel,
// detached log console, and tray icon.

export { Hit, QueueRow, LogRow } from "models.slint";
export { MainWindow } from "main-window.slint";
export { SidePanel } from "side-panel.slint";
export { LogWindow } from "log-window.slint";

export component TrayIcon inherits SystemTrayIcon {
    in-out property <string> status-tip: "Game Larper";
    in-out property <string> game-name: "No game selected";
    in-out property <string> status-line: "Stopped";
    in-out property <string> play-label: "Play";
    in-out property <bool> play-enabled: false;
    in-out property <bool> pause-enabled: false;
    in-out property <bool> stop-enabled: false;
    in-out property <string> queue-line: "Open queue";
    callback open-requested();
    callback play();
    callback pause();
    callback stop();
    callback open-queue();
    callback open-settings();
    callback quit();

    icon: @image-url("../../../assets/branding/game-larper-logo.png");
    tooltip: root.status-tip;
    clicked => { root.open-requested(); }

    Menu {
        MenuItem { title: root.game-name; enabled: false; }
        MenuItem { title: root.status-line; enabled: false; }
        MenuSeparator { }
        MenuItem { title: root.play-label; enabled: root.play-enabled; activated => { root.play(); } }
        MenuItem { title: "Pause"; enabled: root.pause-enabled; activated => { root.pause(); } }
        MenuItem { title: "Stop"; enabled: root.stop-enabled; activated => { root.stop(); } }
        MenuItem { title: root.queue-line; activated => { root.open-queue(); } }
        MenuSeparator { }
        MenuItem { title: "Open Game Larper"; activated => { root.open-requested(); } }
        MenuItem { title: "Settings"; activated => { root.open-settings(); } }
        MenuSeparator { }
        MenuItem { title: "Quit"; activated => { root.quit(); } }
    }
}
