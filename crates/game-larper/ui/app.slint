import { LineEdit, ListView } from "std-widgets.slint";

export { QueueRow } from "models.slint";
export { SidePanel } from "side-panel.slint";

export global Theme {
    out property <color> background: #0D1018;
    out property <color> surface: #151A26;
    out property <color> raised: #1A2030;
    out property <color> border: #2A3144;
    out property <color> text: #F2F4F8;
    out property <color> muted: #AAB3C5;
    out property <color> disabled: #707A8D;
    out property <color> accent: #6E63FF;
    out property <color> accent-hover: #7C72FF;
    out property <color> success: #69DAA5;
    out property <color> warning: #F5BE66;
    out property <color> danger: #FF6475;
}

export struct Hit {
    id: string,
    name: string,
    detail: string,
    art: image,
    selected: bool,
}

component Action inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    min-width: 72px;
    horizontal-stretch: 1;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.border;
    background: !root.enabled ? Theme.surface : touch.pressed ? Theme.raised : touch.has-hover ? (root.primary ? Theme.accent-hover : Theme.raised) : (root.primary ? Theme.accent : Theme.surface);
    animate background { duration: 140ms; easing: ease-out; }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    Text {
        text: root.label;
        color: root.enabled ? Theme.text : Theme.disabled;
        font-weight: 600;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CaptionButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger: false;
    callback clicked();
    width: 46px;
    height: 52px;
    background: touch.has-hover ? (root.danger ? Theme.danger : Theme.raised) : transparent;
    animate background { duration: 120ms; }
    touch := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: root.glyph;
        color: Theme.text;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "Game Larper";
    icon: @image-url("../../../assets/branding/game-larper-logo.png");
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 6px;
    min-width: 960px;
    min-height: 640px;
    preferred-width: 1080px;
    preferred-height: 720px;
    background: Theme.background;
    default-font-family: "Segoe UI Variable";
    default-font-size: 14px;

    in-out property <[Hit]> hits;
    in-out property <string> catalog-status: "Loading the detectable catalog…";
    in-out property <string> empty-message: "";
    in-out property <image> session-art;
    in-out property <string> session-name: "No game selected";
    in-out property <string> session-detail: "Search, then press Play.";
    in-out property <string> session-state: "Stopped";
    in-out property <color> session-color: Theme.muted;
    in-out property <string> session-time: "00:00:00";
    in-out property <string> play-label: "Play";
    in-out property <bool> play-enabled: false;
    in-out property <bool> pause-enabled: false;
    in-out property <bool> stop-enabled: false;
    in-out property <string> queue-count: "Queue";
    // The docked side panel that is open: "", "queue", or "settings".
    in-out property <string> panel;
    in-out property <string> toast: "";

    callback query-edited(string);
    callback choose(int);
    callback activate(int);
    callback play();
    callback pause();
    callback stop();
    callback toggle-queue();
    callback open-settings();
    callback request-close();

    forward-focus: search;

    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 52px;
            background: #000000;
            WindowMoveArea {
                HorizontalLayout {
                    padding-left: 14px;
                    spacing: 8px;
                    alignment: center;
                    Image {
                        source: @image-url("../../../assets/branding/game-larper-banner.png");
                        height: 28px;
                        width: self.height * self.source.width / self.source.height;
                        image-fit: contain;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    CaptionButton { glyph: "–"; clicked => { root.minimized = true; } }
                    CaptionButton { glyph: root.maximized ? "❐" : "□"; clicked => { root.maximized = !root.maximized; } }
                    CaptionButton { glyph: "×"; danger: true; clicked => { root.request-close(); } }
                }
            }
        }

        HorizontalLayout {
            padding: 16px;
            spacing: 16px;
            VerticalLayout {
                spacing: 10px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    search := LineEdit {
                        placeholder-text: "Search games…";
                        horizontal-stretch: 1;
                        edited(text) => { root.query-edited(text); }
                        accepted => { if (root.hits.length > 0) { root.activate(0); } }
                    }
                    Action {
                        label: root.queue-count;
                        min-width: 108px;
                        horizontal-stretch: 0;
                        clicked => { root.toggle-queue(); }
                    }
                    Action {
                        label: "Settings";
                        min-width: 96px;
                        horizontal-stretch: 0;
                        clicked => { root.open-settings(); }
                    }
                }
                Text {
                    text: root.catalog-status;
                    color: Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                }

                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    if (root.hits.length == 0): Text {
                        text: root.empty-message;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for hit[index] in root.hits: Rectangle {
                            height: 68px;
                            background: hit.selected ? Theme.raised : touch.has-hover ? Theme.surface : transparent;
                            border-radius: 10px;
                            border-width: hit.selected ? 1px : 0px;
                            border-color: Theme.border;
                            animate background { duration: 120ms; }
                            touch := TouchArea {
                                clicked => { root.choose(index); }
                                double-clicked => { root.activate(index); }
                            }
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 12px;
                                alignment: center;
                                Rectangle {
                                    width: 48px;
                                    height: 48px;
                                    border-radius: 8px;
                                    background: Theme.raised;
                                    clip: true;
                                    if (hit.art.width > 0): Image {
                                        source: hit.art;
                                        width: 48px;
                                        height: 48px;
                                        image-fit: cover;
                                    }
                                    if (hit.art.width == 0): Text {
                                        text: "GL";
                                        color: Theme.accent;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: hit.name; color: Theme.text; font-weight: 600; overflow: elide; }
                                    Text { text: hit.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                            }
                        }
                    }
                }

            }

            Rectangle {
                width: 300px;
                horizontal-stretch: 0;
                background: Theme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "Active session"; color: Theme.muted; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;
                        Rectangle {
                            width: 72px;
                            height: 72px;
                            border-radius: 10px;
                            background: Theme.raised;
                            clip: true;
                            horizontal-stretch: 0;
                            if (root.session-art.width > 0): Image {
                                source: root.session-art;
                                width: 72px;
                                height: 72px;
                                image-fit: cover;
                            }
                            if (root.session-art.width == 0): Text {
                                text: "GL";
                                color: Theme.accent;
                                font-size: 22px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text { text: root.session-name; color: Theme.text; font-weight: 700; wrap: word-wrap; }
                            Text { text: root.session-detail; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text { text: "●  " + root.session-state; color: root.session-color; font-weight: 600; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.session-time; color: Theme.text; font-size: 20px; font-weight: 700; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Action { label: root.play-label; primary: true; enabled: root.play-enabled; clicked => { root.play(); } }
                        Action { label: "Pause"; enabled: root.pause-enabled; clicked => { root.pause(); } }
                        Action { label: "Stop"; enabled: root.stop-enabled; clicked => { root.stop(); } }
                    }
                    Text {
                        text: "Discord keeps the profile, the icon, and the timer. This window only starts the stand-in.";
                        color: Theme.disabled;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    if (root.toast != ""): Rectangle {
        y: root.height - 64px;
        x: (root.width - self.width) / 2;
        width: min(520px, root.width - 48px);
        height: 40px;
        background: Theme.raised;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        Text {
            text: root.toast;
            color: Theme.text;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    in-out property <string> status-tip: "Game Larper";
    in-out property <string> game-name: "No game selected";
    in-out property <string> status-line: "Stopped";
    in-out property <string> play-label: "Play";
    in-out property <bool> play-enabled: false;
    in-out property <bool> pause-enabled: false;
    in-out property <bool> stop-enabled: false;
    in-out property <string> queue-line: "Open queue";
    callback open-requested();
    callback play();
    callback pause();
    callback stop();
    callback open-queue();
    callback open-settings();
    callback quit();

    icon: @image-url("../../../assets/branding/game-larper-logo.png");
    tooltip: root.status-tip;
    clicked => { root.open-requested(); }

    Menu {
        MenuItem { title: root.game-name; enabled: false; }
        MenuItem { title: root.status-line; enabled: false; }
        MenuSeparator { }
        MenuItem { title: root.play-label; enabled: root.play-enabled; activated => { root.play(); } }
        MenuItem { title: "Pause"; enabled: root.pause-enabled; activated => { root.pause(); } }
        MenuItem { title: "Stop"; enabled: root.stop-enabled; activated => { root.stop(); } }
        MenuItem { title: root.queue-line; activated => { root.open-queue(); } }
        MenuSeparator { }
        MenuItem { title: "Open Game Larper"; activated => { root.open-requested(); } }
        MenuItem { title: "Settings"; activated => { root.open-settings(); } }
        MenuSeparator { }
        MenuItem { title: "Quit"; activated => { root.quit(); } }
    }
}
