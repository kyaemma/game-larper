// Presentation models filled by Rust.

export struct Hit {
    // Discord application id.
    id: string,
    // Empty when the catalog knows no Steam app.
    steam-id: string,
    name: string,
    art: image,
    selected: bool,
    // Starred by the user.
    favorite: bool,
    // A favorite the catalog does not list right now. Shown dimmed, and never playable.
    missing: bool,
}

// A row of the tray panel's Favorites and Recent lists.
export struct TrayGame {
    // Discord application id.
    id: string,
    name: string,
    // The second line: how long ago, or why the row cannot be launched.
    meta: string,
    art: image,
    // False when the catalog does not list the game right now.
    available: bool,
    // The runner is on this game right now.
    active: bool,
}

export struct QueueRow {
    name: string,
    meta: string,
    art: image,
    active: bool,
}

export struct LogRow {
    time: string,
    level: string,
    // Which part of the app wrote the line, such as "runner" or "queue".
    area: string,
    message: string,
    // Level color.
    tone: color,
    // Debug detail reads quieter than the events around it.
    quiet: bool,
}
